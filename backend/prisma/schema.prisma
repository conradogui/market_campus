generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anuncio {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  categoria   String
  preco       Float?
  isDoacao    Boolean  @default(false)
  imagemUrl   String?
  userId      String
  createdAt   DateTime @default(now())
}